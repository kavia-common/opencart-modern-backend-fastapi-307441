# Application Configuration
APP_NAME=OpenCart Modern API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Database
DATABASE_URL=sqlite:///./data/opencart.db

# Security
# IMPORTANT: Change this to a random secret key in production!
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-MIN-32-CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS - allowed origins for frontend
# Can be JSON array or comma-separated string
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# API Configuration
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc
OPENAPI_URL=/openapi.json
